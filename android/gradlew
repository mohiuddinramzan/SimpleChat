#!/bin/sh
# Minimal Gradle Wrapper launcher. It needs gradle/wrapper/gradle-wrapper.jar.
# If the jar is not committed, the GitHub Actions workflow generates the official
# wrapper (jar + scripts) with `gradle wrapper` before building.

APP_HOME=$( cd "$(dirname "$0")" > /dev/null && pwd -P ) || exit 1

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD=$JAVA_HOME/bin/java
else
    JAVACMD=java
fi
if ! command -v "$JAVACMD" > /dev/null 2>&1; then
    echo "ERROR: Java was not found. Install JDK 17 or set JAVA_HOME." >&2
    exit 1
fi

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar
if [ ! -f "$CLASSPATH" ]; then
    echo "ERROR: $CLASSPATH is missing. See README (Gradle Wrapper)." >&2
    exit 1
fi

exec "$JAVACMD" -Xmx64m -Xms64m -Dorg.gradle.appname=gradlew \
    -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
